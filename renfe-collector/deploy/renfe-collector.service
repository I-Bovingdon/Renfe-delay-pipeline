[Unit]
Description=Colector GTFS-RT RENFE Cercanias (TFM)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Rutas del despliegue real en el VPS (repo en /home/tfm/tfm-cercanias-colectores,
# datos fuera del repo en /home/tfm/data-renfe). Instalado en /etc/systemd/system/.
User=tfm
WorkingDirectory=/home/tfm/tfm-cercanias-colectores/renfe-collector
ExecStart=/usr/bin/python3 /home/tfm/tfm-cercanias-colectores/renfe-collector/scripts/collector.py --data-dir /home/tfm/data-renfe --interval 60
Restart=always
RestartSec=15
# Si la maquina anda justa de memoria, esto evita sustos:
MemoryMax=300M

[Install]
WantedBy=multi-user.target
